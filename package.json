{
  "name": "portfolio-regression-lab",
  "private": true,
  "description": "Bilingual static portfolio build and regression tooling",
  "scripts": {
    "test:serve": "node tests/runtime/server.mjs",
    "test:qa": "playwright test --config tests/qa/playwright.config.cjs",
    "test:visual:update": "UPDATE_BASELINE=1 playwright test --config tests/qa/playwright.config.cjs --grep \"approved visual|every project presentation\"",
    "test:performance": "node tests/performance/run.mjs",
    "test:source": "node tests/verify-original.mjs",
    "test:inventory": "node tests/inventory/generate.cjs --check",
    "test": "node tests/gate.mjs",
    "test:baseline-integrity": "node tests/artifact-lock.mjs",
    "test:performance:compare": "node tests/performance/compare.mjs",
    "content:check": "node scripts/content/validate-project-data.mjs",
    "build:content:preview": "node scripts/content/build.mjs",
    "content:build": "node scripts/content/build.mjs --site",
    "content:build:check": "node scripts/content/build.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0"
  }
}
